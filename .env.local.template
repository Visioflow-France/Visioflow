# ============================================================
# CONFIGURATION STRIPE - Visioflow
# ============================================================
# Instructions :
# 1. Renommez ce fichier en ".env.local" (supprimez .template)
# 2. Remplacez les placeholders par les vraies clés Stripe de votre frère
# 3. NE JAMAIS COMMITTER .env.local sur git (il est déjà dans .gitignore)

# Clé secrète Stripe (commence par sk_test_ ou sk_live_)
# À récupérer dans : Dashboard Stripe → Developers → API keys
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Clé publique Stripe (commence par pk_test_ ou pk_live_)
# À récupérer dans : Dashboard Stripe → Developers → API keys
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Webhook secret (optionnel, pour la réception des webhooks Stripe)
# À configurer après création du webhook endpoint
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ============================================================
# AUTRES CONFIGURATIONS
# ============================================================

# Token admin pour accéder au dashboard (optionnel)
# Génère une chaîne aléatoire sécurisée pour protéger l'accès admin
# ADMIN_TOKEN=votre_token_secret_ici

# Mot de passe de connexion au dashboard /login-admin
# ADMIN_PASSWORD=votre_mot_de_passe_ici

# ============================================================
# FIREBASE (OBLIGATOIRE en production — sans ça, le dashboard
# ne peut ni lire ni enregistrer les projets/formulaires)
# ============================================================
# Firebase Console → Paramètres du projet → Comptes de service
# → "Générer une nouvelle clé privée" → collez le JSON COMPLET
# ci-dessous sur une seule valeur (les retours à la ligne sont OK).
# Sur Vercel : Settings → Environment Variables → FIREBASE_SERVICE_ACCOUNT
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Optionnel : clé API web actuelle (pour le repli REST de /api/save-form).
# ATTENTION : l'ancienne clé AIzaSyD2R3SfaC6ifiA_juCfM_1q7SRaAm-G1gY
# n'est plus valide — ne pas la réutiliser.
# FIREBASE_API_KEY=votre_cle_api_web_actuelle

# Optionnel : ID du projet Firebase (défaut : visioflow-cb6eb-9d051)
# FIREBASE_PROJECT_ID=visioflow-cb6eb-9d051

# ============================================================
# NOTES IMPORTANTES
# ============================================================
# - En mode test (sk_test_), utilisez les cartes de test Stripe : https://stripe.com/docs/testing
# - Pour passer en production, remplacez les clés test par les clés live
# - Gardez ces clés secrètes, ne les partagez jamais !
